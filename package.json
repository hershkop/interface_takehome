{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Record an LLM-driven UI run as a typed capability artifact; replay it deterministically.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "tsx scripts/probe.ts",
    "install:browsers": "playwright install chromium",
    "build:css": "tailwindcss -i ./src/console/tailwind.css -o ./src/console/app.css --minify",
    "watch:css": "tailwindcss -i ./src/console/tailwind.css -o ./src/console/app.css --watch",
    "console": "npm run build:css && tsx src/console/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dotenv": "^17.2.3",
    "playwright": "^1.63.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.9.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
