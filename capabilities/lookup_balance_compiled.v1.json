{
  "schemaVersion": "1.0",
  "capabilityId": "lookup_balance_compiled",
  "version": "1.0.0",
  "metadata": {
    "name": "lookup balance compiled",
    "description": "Log in, then look up account 12678 and read its current balance and account type from the account detail screen.",
    "status": "draft",
    "risk": "safe",
    "recordedAt": "2026-09-29T15:17:11.979Z",
    "recordedBy": "llm",
    "model": "claude-opus-5",
    "compiledWith": {
      "skills": [
        {
          "id": "classify-risk",
          "version": "1.0.0"
        },
        {
          "id": "durable-locators",
          "version": "1.0.0"
        },
        {
          "id": "outcomes-and-handlers",
          "version": "1.0.0"
        },
        {
          "id": "parameterise-and-secrets",
          "version": "1.0.0"
        },
        {
          "id": "stop-rather-than-guess",
          "version": "1.0.0"
        },
        {
          "id": "web-observation",
          "version": "1.0.0"
        }
      ],
      "memory": [
        {
          "id": "account-not-found-wording",
          "version": "1.0.0"
        },
        {
          "id": "hidden-internal-error",
          "version": "1.0.0"
        },
        {
          "id": "login-fields-unnamed",
          "version": "1.0.0"
        },
        {
          "id": "session-expiry-bounces-to-login",
          "version": "1.0.0"
        }
      ]
    }
  },
  "target": {
    "app": "parabank",
    "surface": "web",
    "baseUrl": "http://localhost:18080/parabank"
  },
  "inputs": {
    "accountId": {
      "type": "string",
      "required": true,
      "sensitive": false
    }
  },
  "outputs": {
    "balance": {
      "type": "number",
      "source": {
        "kind": "variable",
        "name": "balance"
      },
      "coerce": "currency",
      "onMissing": "fail"
    },
    "accountType": {
      "type": "string",
      "source": {
        "kind": "variable",
        "name": "accountType"
      },
      "coerce": "trim",
      "onMissing": "fail"
    }
  },
  "steps": [
    {
      "id": "navigate_0",
      "action": {
        "action": "navigate",
        "url": "{{baseUrl}}/index.htm"
      },
      "rationale": "Open the locally hosted ParaBank login page, which is the allowed origin."
    },
    {
      "id": "fill_1",
      "action": {
        "action": "fill",
        "target": {
          "candidates": [
            {
              "strategy": "css",
              "value": "input[name=\"username\"]"
            }
          ]
        },
        "value": "{{secrets.parabankUsername}}"
      },
      "rationale": "Fill the username field; it has no accessible name or associated label, so I target it by its stable form input name attribute."
    },
    {
      "id": "fill_2",
      "action": {
        "action": "fill",
        "target": {
          "candidates": [
            {
              "strategy": "css",
              "value": "input[name=\"password\"]"
            }
          ]
        },
        "value": "{{secrets.parabankPassword}}"
      },
      "rationale": "Fill the password field; like the username field it has no accessible name, so I target it by its form input name attribute."
    },
    {
      "id": "click_3",
      "action": {
        "action": "click",
        "target": {
          "description": "Log In",
          "candidates": [
            {
              "strategy": "role",
              "role": "button",
              "name": "Log In",
              "exact": false
            }
          ]
        },
        "button": "left"
      },
      "rationale": "Submit the login form using the button's accessible name."
    },
    {
      "id": "navigate_4",
      "action": {
        "action": "navigate",
        "url": "{{baseUrl}}/activity.htm?id={{inputs.accountId}}"
      },
      "rationale": "Open the account detail screen for the requested account; the overview table has no account links, so the id is supplied via the URL as the parameterised input."
    },
    {
      "id": "wait_5",
      "action": {
        "action": "wait",
        "condition": {
          "kind": "text",
          "value": "{{inputs.accountId}}",
          "visible": true
        },
        "timeoutMs": 10000
      },
      "rationale": "Wait for the account detail values to populate before reading them."
    },
    {
      "id": "extract_6",
      "action": {
        "action": "extract",
        "target": {
          "candidates": [
            {
              "strategy": "css",
              "value": "#balance"
            }
          ]
        },
        "as": "balance"
      },
      "rationale": "Capture the account balance from the Balance row of the Account Details table; the value cell has no accessible name of its own, so it is located by its stable id within the details table."
    },
    {
      "id": "extract_7",
      "action": {
        "action": "extract",
        "target": {
          "candidates": [
            {
              "strategy": "css",
              "value": "#accountType"
            }
          ]
        },
        "as": "accountType"
      },
      "rationale": "Capture the account type from the Account Type row; the value cell has no accessible name, so it is located by its stable id."
    }
  ],
  "handlers": [],
  "checkpoint": {
    "kind": "text",
    "value": "Account Details",
    "visible": true
  }
}
