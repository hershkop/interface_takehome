# Target
PARABANK_PORT=8080
PARABANK_BASE_URL=http://localhost:8080/parabank

# Seed credentials created by `npm run setup` (POST .../initializeDB).
# Synthetic demo data — ParaBank's own fixture user. Never real credentials.
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo

# Required only for `discover` (the LLM run). Replay never reads this.
ANTHROPIC_API_KEY=
